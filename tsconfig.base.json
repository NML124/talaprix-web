{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "isolatedModules": true,
    "paths": {
      "@talaprix/shared/ui-kit": ["./libs/shared/ui-kit/src/index.ts"],
      "@talaprix/shared/models": ["./libs/shared/models/src/index.ts"],
      "@talaprix/shared/utils": ["./libs/shared/utils/src/index.ts"],
      "@talaprix/products/domain": ["./libs/products/domain/src/index.ts"],
      "@talaprix/products/data-access": [
        "./libs/products/data-access/src/index.ts"
      ],
      "@talaprix/products/ui": ["./libs/products/ui/src/index.ts"],
      "@talaprix/products/feature-web": [
        "./libs/products/feature-web/src/index.ts"
      ],
      "@talaprix/products/feature-admin": [
        "./libs/products/feature-admin/src/index.ts"
      ],
      "@talaprix/users/domain": ["./libs/users/domain/src/index.ts"],
      "@talaprix/users/data-access": ["./libs/users/data-access/src/index.ts"],
      "@talaprix/users/feature-auth": [
        "./libs/users/feature-auth/src/index.ts"
      ],
      "@talaprix/scrapers/data-access": [
        "./libs/scrapers/data-access/src/index.ts"
      ],
      "@talaprix/scrapers/feature-admin": [
        "./libs/scrapers/feature-admin/src/index.ts"
      ],
      "@talaprix/generators": ["./tools/generators/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG ADMIN_SUPABASE_URL
ARG ADMIN_SUPABASE_ANON_KEY
RUN test -n "$ADMIN_SUPABASE_URL" && test -n "$ADMIN_SUPABASE_ANON_KEY" \
  && NX_DAEMON=false npx nx build admin --configuration=production --skip-nx-cache

FROM nginx:stable-alpine
COPY apps/admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/apps/admin/browser/ /usr/share/nginx/html/
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
